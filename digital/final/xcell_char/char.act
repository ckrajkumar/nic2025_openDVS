import std;
import std::cells;
import std::delay_lines;
import "../async_readout_cells.act";

defproc characterize()
{
  std::cells::TIELOX1  g1;
  std::cells::TIEHIX1  g2;
  std::cells::INVX1    g3;
  std::cells::INVX2    g4;
  std::cells::INVX4    g5;
  std::cells::INVX8    g6;
  std::cells::BUFX2    g7;
  std::cells::NOR2X1   g8;
  std::cells::NOR2X2   g9;
  std::cells::NOR3X1   g10;
  std::cells::OR2X1    g11;
  std::cells::OR2X2    g12;
  std::cells::NAND2X1  g13;
  std::cells::NAND3X1  g14;
  std::cells::AND2X1   g15;
  std::cells::AND2X2   g16;
  std::cells::XOR2X1   g17;
  std::cells::XNOR2X1  g18;
  std::cells::MUX2X1   g19;
  std::cells::OAI21X1  g20;
  std::cells::AOI21X1  g21;
  std::cells::OAI22X1  g22;
  std::cells::AOI22X1  g23;
  std::cells::TBUF1    g24;
  std::cells::LATCH    g25;
  std::cells::LATCHINV g26;

  /*
   * Custom ring/expression-synthesis cells - the other 19 of the 45
   * cells `interact` reported as "used in the design" during
   * `make layout` (the std::cells above account for the remaining 26).
   * Defined in ../async_readout_cells.act, namespace `cell`, which is
   * itself an output artifact (ckt:cell-save in layout_gen.scm) capturing
   * exactly the cell library the actual design used - not hand-written.
   */
  cell::ginvx0                   g27;
  cell::ginvx1                   g28;
  cell::ginvx2                   g29;
  cell::ginvx3                   g30;
  cell::ginvx4                   g31;
  cell::ginvx5                   g32;
  cell::ginvx8                   g33;
  cell::ginvx9                   g34;
  cell::gac1x1                   g35;
  cell::gcelem2x0                g36;
  cell::gcelem3x0                g37;
  cell::gnand2x0                 g38;
  cell::gnor2x0                  g39;
  cell::gnor3x0                  g40;
  cell::g0n1n2n3naaa_023aox0     g41;
  cell::g0n1n2n3naaa_0123aaox0   g42;
  cell::g0n1n2n3naaa_0123aaox1   g43;
  cell::g0n1n2naa_012aox0        g44;
  cell::g0n1no_012aax0           g45;

  /*
   * Ring's own delay-line building blocks (std::delay_elements, from
   * std/delay_lines.act) - not part of this design's netlist directly,
   * but what synth.conf's pulse_width and delay_params/delay_vals tables
   * actually calibrate (see ring_forge.cc's delay_line_0..3 ->
   * chain_delay_buffer<N> / chain_weak_delay_buffer<N,5>). Needed to
   * close the loop on the deferred parts of Stage 3.
   */
  std::delay_elements::delay_buffer         g46;
  std::delay_elements::weak_delay_buffer<5> g47;
}

characterize c;
