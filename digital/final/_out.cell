LAYER LEGALIZER
   SAME_DIFF_SPACING 0.450000 ;
   ANY_DIFF_SPACING 0.525000 ;
   WELLTAP_ADJUST 0.000000 ;
END LEGALIZER

LAYER nwell
    MINWIDTH 0.900000 ;
    SPACING 1.275000 ;
    OPPOSPACING 0.000000 ;
    MAXPLUGDIST 75.000000 ;
    OVERHANG 0.225000 ;
END nwell

MACRO welltap_svt
   VERSION welltap_svt
   PLUG
   LAYER nwell ;
   RECT 0.375000 0.825000 0.975000 1.800000
   END
   END VERSION
END welltap_svt
